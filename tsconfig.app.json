{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    /* "noUnusedLocals": false,      // Cambiado a false para ignorar variables no usadas
    "noUnusedParameters": false,  // Cambiado a false para ignorar parámetros no usados */
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true, // Permite importar .tsx explícitamente si es necesario
    "types": ["vite/client", "node"], 
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite-env.d.ts"] 
}